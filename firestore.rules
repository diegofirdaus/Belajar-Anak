rules_version = '2';

// Semua data dibaca dan ditulis lewat server Markas Latihan (Admin SDK),
// yang memeriksa login orang tua dan kepemilikan profil. Akses langsung dari
// browser ke Firestore ditolak seluruhnya.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
