# Firebase — konfigurasi web (boleh terlihat di browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK — RAHASIA, hanya di server. Isi dengan JSON service account dalam satu baris.
FIREBASE_SERVICE_ACCOUNT=

# Claude API — hanya di server, jangan pernah diberi prefix NEXT_PUBLIC_
ANTHROPIC_API_KEY=
AI_MODEL_SOAL=claude-sonnet-5-5
AI_MODEL_RAPIKAN=claude-haiku-5-5

# Batas harian
AI_LIMIT_PER_PLAYER=20
AI_LIMIT_PER_FAMILY=60
AI_LIMIT_RAPIKAN_PER_FAMILY=30
